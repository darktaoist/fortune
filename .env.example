SUPABASE_URL=your-supabase-project-url
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google AdSense (free result pages only). Defaults to the 1.0 publisher id if unset.
NUXT_PUBLIC_ADSENSE_CLIENT=ca-pub-4183772800767937

# AI providers
AI_PROVIDER=deepseek
ANTHROPIC_API_KEY=
PREMIUM_MODEL=claude-sonnet-4-6
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ============================================================
# Payments (Toss Payments v2)
# PAYMENT_MODE: test | live  (selects which key set is used)
# ============================================================
PAYMENT_MODE=test

# Client keys (browser) - KR card payment, API individual integration (ck)
TOSS_CLIENT_KEY_TEST=
TOSS_CLIENT_KEY_LIVE=

# Widget keys (browser) - overseas PayPal via Toss widget (gck)
TOSS_WIDGET_KEY_TEST=
TOSS_WIDGET_KEY_LIVE=

# Secret keys (SERVER ONLY) - https://developers.tosspayments.com
# - TOSS_SECRET_KEY_*        : pairs with TOSS_CLIENT_KEY_*  (sk_...)
# - TOSS_WIDGET_SECRET_KEY_* : pairs with TOSS_WIDGET_KEY_*  (gsk_...)
TOSS_SECRET_KEY_TEST=
TOSS_SECRET_KEY_LIVE=
TOSS_WIDGET_SECRET_KEY_TEST=
TOSS_WIDGET_SECRET_KEY_LIVE=
